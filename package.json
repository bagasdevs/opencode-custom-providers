{
  "name": "opencode-custom-providers",
  "version": "1.0.3",
  "description": "Dynamic model discovery for OpenAI-compatible, Gemini and Ollama providers in OpenCode with models.dev enrichment. Anthropic models are added from the catalog",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bagasdevs/opencode-custom-providers.git"
  },
  "homepage": "https://github.com/bagasdevs/opencode-custom-providers#readme",
  "bugs": {
    "url": "https://github.com/bagasdevs/opencode-custom-providers/issues"
  },
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "files": [
    "dist",
    "bundles",
    "scripts/postinstall.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "default": "./dist/tui.js"
    }
  },
  "scripts": {
    "build": "node ./scripts/clean-dist.mjs && tsc",
    "bundles": "node ./scripts/build-bundles.mjs",
    "postinstall": "node ./scripts/postinstall.js",
    "prepack": "npm run build && npm run bundles",
    "test": "npm run build && node tests/security.test.mjs && node tests/discovery.test.mjs",
    "test:src": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "lint": "eslint src tests",
    "prepare": "npm run build || echo \"prepare: build skipped (devDependencies probably absent; using committed dist/)\"",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "opencode",
    "plugin",
    "ai",
    "openai",
    "dynamic",
    "discovery",
    "models.dev"
  ],
  "author": "bagasdevs",
  "license": "MIT",
  "devDependencies": {
    "@opencode-ai/plugin": "^1.14.0",
    "@opencode-ai/sdk": "^1.14.0",
    "@opencode/plugin": "^2.0.32",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.14.0",
    "@opencode/plugin": "^2.0.32"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    },
    "@opencode/plugin": {
      "optional": true
    }
  },
  "engines": {
    "opencode": ">=1.14.0"
  },
  "trustedDependencies": [
    "opencode-custom-providers"
  ]
}
